    def admin_records(self):
        self.clear_screen()
        self.heading("QUEUE RECORDS")

        filters = tk.Frame(self.root)
        filters.pack(fill="x", padx=10)

        tk.Label(filters, text="Search:").pack(side="left")
        search_entry = tk.Entry(filters, width=25)
        search_entry.pack(side="left", padx=5)

        tk.Label(filters, text="Status:").pack(side="left", padx=5)
        status_box = ttk.Combobox(
            filters,
            values=["All", "Waiting", "Serving", "Completed", "Cancelled"],
            state="readonly",
            width=15
        )
        status_box.set("All")
        status_box.pack(side="left", padx=5)

        columns = (
            "Queue", "Student ID", "Name", "Service",
            "Registered", "Status", "Window"
        )

        tree = ttk.Treeview(
            self.root, columns=columns, show="headings", height=18
        )

        widths = [85, 100, 150, 140, 150, 100, 100]
        for col, width in zip(columns, widths):
            tree.heading(col, text=col)
            tree.column(col, width=width)

        tree.pack(fill="both", expand=True, padx=10, pady=10)

        def refresh():
            for item in tree.get_children():
                tree.delete(item)

            records = get_records(
                status_box.get(), search_entry.get().strip()
            )

            for record in records:
                tree.insert(
                    "", "end",
                    values=(
                        record[0], record[1], record[2], record[3],
                        record[4], record[5], record[6]
                    )
                )

        tk.Button(
            filters, text="Search / Filter", command=refresh
        ).pack(side="left", padx=5)

        tk.Button(
            filters, text="Clear",
            command=lambda: (
                search_entry.delete(0, tk.END),
                status_box.set("All"),
                refresh()
            )
        ).pack(side="left", padx=5)

        tk.Button(
            self.root, text="Back",
            command=self.admin_dashboard
        ).pack(pady=5)

        refresh()

    def manage_windows(self):
        self.clear_screen()
        self.heading("MANAGE SERVICE WINDOWS")

        columns = ("ID", "Window Name", "Status")
        tree = ttk.Treeview(
            self.root, columns=columns, show="headings", height=15
        )

        tree.heading("ID", text="ID")
        tree.heading("Window Name", text="Window Name")
        tree.heading("Status", text="Status")

        tree.column("ID", width=80)
        tree.column("Window Name", width=250)
        tree.column("Status", width=150)

        tree.pack(fill="both", expand=True, padx=15, pady=10)

        def refresh():
            for item in tree.get_children():
                tree.delete(item)

            for window_id, name, active in get_windows():
                status = "Active" if active else "Inactive"
                tree.insert(
                    "", "end", values=(window_id, name, status)
                )

        def selected_window():
            selection = tree.selection()
            if not selection:
                messagebox.showerror(
                    "Error", "Please select a service window."
                )
                return None
            return tree.item(selection[0])["values"]

        def add_window():
            name = simpledialog.askstring(
                "Add Window", "Enter the new window name:", parent=self.root
            )

            if not name or not name.strip():
                return

            try:
                conn = connect_db()
                conn.execute(
                    "INSERT INTO service_windows (window_name, active) VALUES (?, 1)",
                    (name.strip(),)
                )
                conn.commit()
                conn.close()
                refresh()
            except sqlite3.IntegrityError:
                messagebox.showerror(
                    "Error", "A window with that name already exists."
                )

        def edit_window():
            row = selected_window()
            if not row:
                return

            new_name = simpledialog.askstring(
                "Edit Window",
                "Enter the new window name:",
                initialvalue=row[1],
                parent=self.root
            )

            if not new_name or not new_name.strip():
                return

            try:
                conn = connect_db()
                conn.execute(
                    "UPDATE service_windows SET window_name = ? WHERE id = ?",
                    (new_name.strip(), row[0])
                )
                conn.commit()
                conn.close()
                refresh()
            except sqlite3.IntegrityError:
                messagebox.showerror(
                    "Error", "That window name already exists."
                )

        def toggle_window():
            row = selected_window()
            if not row:
                return

            window_id = row[0]

            conn = connect_db()
            cur = conn.cursor()
            cur.execute(
                "SELECT active FROM service_windows WHERE id = ?",
                (window_id,)
            )
            active = cur.fetchone()[0]

            if active:
                cur.execute("""
                    SELECT COUNT(*) FROM queue_records
                    WHERE window_id = ? AND status = 'Serving'
                """, (window_id,))
                serving = cur.fetchone()[0]

                if serving:
                    conn.close()
                    messagebox.showerror(
                        "Cannot Deactivate",
                        "This window is currently serving a student."
                    )
                    return

            cur.execute(
                "UPDATE service_windows SET active = ? WHERE id = ?",
                (0 if active else 1, window_id)
            )
            conn.commit()
            conn.close()
            refresh()

        buttons = tk.Frame(self.root)
        buttons.pack(pady=8)

        tk.Button(
            buttons, text="Add Window", command=add_window
        ).pack(side="left", padx=5)

        tk.Button(
            buttons, text="Edit Window", command=edit_window
        ).pack(side="left", padx=5)

        tk.Button(
            buttons, text="Activate / Deactivate",
            command=toggle_window
        ).pack(side="left", padx=5)

        tk.Button(
            buttons, text="Refresh", command=refresh
        ).pack(side="left", padx=5)

        tk.Button(
            buttons, text="Back",
            command=self.admin_dashboard
        ).pack(side="left", padx=5)

        refresh()

