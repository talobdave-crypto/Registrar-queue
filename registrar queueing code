                )

        tk.Button(
            self.root, text="Back",
            command=self.admin_dashboard
        ).pack(pady=5)

    def reset_queue(self):
        confirm = messagebox.askyesno(
            "Confirm Reset",
            "Reset the active queue?\n\n"
            "Waiting records will be cancelled. "
            "Completed and cancelled history will be preserved."
        )

        if not confirm:
            return

        conn = connect_db()
        cur = conn.cursor()
        cur.execute("""
            UPDATE queue_records
            SET status = 'Cancelled'
            WHERE status IN ('Waiting', 'Serving')
        """)
        conn.commit()
        conn.close()

        messagebox.showinfo(
            "Queue Reset", "The active queue has been reset."
        )
        self.admin_dashboard()


if __name__ == "__main__":
    setup_database()
    root = tk.Tk()
    app = RegistrarApp(root)
    root.mainloop()
